{
  "name": "pi-renew",
  "version": "1.0.0",
  "description": "Pi agent extension: reset a live session's context and continue with a caller-supplied payload.",
  "main": "pi-renew.ts",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-agent",
    "extension",
    "context-restart",
    "delegate"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@types/node": "20.19.9",
    "typescript": "5.3.3",
    "typebox": "1.3.7",
    "vitest": "1.6.0"
  },
  "pi": {
    "extensions": [
      "./pi-renew.ts"
    ]
  },
  "vitest": {
    "include": ["test/**/*.test.ts"],
    "environment": "node",
    "globals": true,
    "deps": {
      "moduleDirectories": ["node_modules"]
    }
  }
}
