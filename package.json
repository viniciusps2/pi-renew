{
  "name": "pi-renew",
  "version": "1.0.0",
  "description": "A context-restart primitive for the pi coding agent, plus /renew-loop — a bounded work loop whose state lives in a handover file — and the delegation skills its opt-in brief-and-review mode uses.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-agent",
    "extension",
    "context-restart",
    "delegate",
    "loop",
    "renew-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciusps2/pi-renew.git"
  },
  "homepage": "https://github.com/viniciusps2/pi-renew#readme",
  "bugs": {
    "url": "https://github.com/viniciusps2/pi-renew/issues"
  },
  "bin": {
    "pi-renew": "install.mjs"
  },
  "files": [
    "install.mjs",
    "pi-extensions/pi-renew/*.ts",
    "pi-extensions/pi-renew/package.json",
    "pi-extensions/pi-renew/README.md",
    "skills/**/*",
    "prompts/**/*",
    "docs/**/*",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./pi-extensions/pi-renew/pi-renew.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
